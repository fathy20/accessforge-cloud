# Application configuration placeholders — copy to .env and fill in.
# Never commit a populated .env.

# --- Environment -------------------------------------------------------------
# One of: development | test | production (default: development)
APP_ENV=YOUR_APP_ENV

# --- Database ----------------------------------------------------------------
# Either provide a full SQLAlchemy URL...
DATABASE_URL=YOUR_DATABASE_URL
# ...or let the app assemble a SQL Server URL from these parts:
SQL_SERVER_HOST=YOUR_SQL_SERVER_HOST
SQL_SERVER_PORT=YOUR_SQL_SERVER_PORT
SQL_SERVER_DB=YOUR_SQL_SERVER_DB
SQL_SERVER_DRIVER=YOUR_SQL_SERVER_DRIVER
SQL_SERVER_TRUSTED_CONNECTION=YOUR_SQL_SERVER_TRUSTED_CONNECTION
SQL_SERVER_USER=YOUR_SQL_SERVER_USER
SQL_SERVER_PASSWORD=YOUR_SQL_SERVER_PASSWORD
# Log SQL statements (development only): 1/true/on
SQL_ECHO=YOUR_SQL_ECHO

# --- Authentication ----------------------------------------------------------
# JWT_SECRET_KEY must be at least 32 characters; generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY
# Allow self-service registration (pending admin approval). Default: true.
SELF_SIGNUP_ENABLED=YOUR_SELF_SIGNUP_ENABLED

# --- URLs and CORS -----------------------------------------------------------
BASE_URL=YOUR_BASE_URL
# Comma-separated exact origins. A wildcard '*' is refused in production
# (credentialed CORS forbids it). Default: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=YOUR_CORS_ORIGINS
REDSEA_BASE_URL=YOUR_REDSEA_BASE_URL
VITE_API_URL=YOUR_VITE_API_URL

# --- Artifact storage --------------------------------------------------------
# Absolute directory for uploads/outputs. Default: <project root>/local_storage
ARTIFACT_STORAGE_DIR=YOUR_ARTIFACT_STORAGE_DIR
# Days before an artifact's retention expires (unset = keep forever)
ARTIFACT_RETENTION_DAYS=YOUR_ARTIFACT_RETENTION_DAYS

# --- Optional LEON official report configuration -------------------------------
LEON_BASE_URL=YOUR_LEON_BASE_URL
LEON_REFRESH_TOKEN=YOUR_LEON_REFRESH_TOKEN
LEON_MCP_URL=YOUR_LEON_MCP_URL
LEON_TIMEOUT_SECONDS=YOUR_LEON_TIMEOUT_SECONDS

# --- Operator bootstrap inputs -------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=YOUR_BOOTSTRAP_ADMIN_EMAIL
BOOTSTRAP_ADMIN_PASSWORD=YOUR_BOOTSTRAP_ADMIN_PASSWORD
